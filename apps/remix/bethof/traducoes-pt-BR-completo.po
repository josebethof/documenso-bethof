msgid "<0>Everyone</0> - Everyone can access and view the document"
msgstr "<0>Todos</0>: todos podem acessar e visualizar o documento"

msgid "<0>Inherit authentication method</0> - Use the global action signing authentication method configured in the \"General Settings\" step"
msgstr "<0>Herdar método de autenticação</0>: usar o método global de autenticação para assinatura definido na etapa \"Configurações gerais\""

msgid "<0>Managers and above</0> - Only managers and above can access and view the document"
msgstr "<0>Gerentes e acima</0>: apenas gerentes e cargos superiores podem acessar e visualizar o documento"

msgid "<0>No restrictions</0> - No authentication required"
msgstr "<0>Sem restrições</0>: nenhuma autenticação necessária"

msgid "<0>No restrictions</0> - The document can be accessed directly by the URL sent to the recipient"
msgstr "<0>Sem restrições</0>: o documento pode ser acessado diretamente pelo link enviado ao destinatário"

msgid "<0>None</0> - No authentication required"
msgstr "<0>Nenhum</0>: nenhuma autenticação necessária"

msgid "<0>None</0> - We will generate links which you can send to the recipients manually."
msgstr "<0>Nenhum</0>: vamos gerar links para você enviar aos destinatários manualmente."

msgid "<0>Note</0> - If you use Links in combination with direct templates, you will need to manually send the links to the remaining recipients."
msgstr "<0>Nota</0>: se você usar links junto com modelos de link direto, precisará enviar manualmente os links aos destinatários restantes."

msgid "<0>Organisation</0> templates are shared across all teams in your organisation but can only be edited by the owning team."
msgstr "Os modelos da <0>organização</0> são compartilhados com todas as equipes da sua organização, mas só a equipe dona pode editá-los."

msgid "<0>Private</0> templates can only be used by your team."
msgstr "Os modelos <0>privados</0> só podem ser usados pela sua equipe."

msgid "<0>Public</0> templates are linked to your public profile."
msgstr "Os modelos <0>públicos</0> ficam ligados ao seu perfil público."

msgid "<0>Require 2FA</0> - The recipient must have an account and 2FA enabled via their settings"
msgstr "<0>Exigir 2FA</0>: o destinatário precisa ter uma conta com 2FA ativado nas configurações"

msgid "<0>Require account</0> - The recipient must be signed in to view the document"
msgstr "<0>Exigir conta</0>: o destinatário precisa entrar na conta para visualizar o documento"

msgid "<0>Require passkey</0> - The recipient must have an account and passkey configured via their settings"
msgstr "<0>Exigir chave de acesso</0>: o destinatário precisa ter uma conta com chave de acesso cadastrada nas configurações"

msgid "<0>Require password</0> - The recipient must have an account and password configured via their settings, the password will be verified during signing"
msgstr "<0>Exigir senha</0>: o destinatário precisa ter uma conta com senha cadastrada nas configurações. A senha será verificada durante a assinatura"

msgid "<0>Typed</0> - A signature that is typed using a keyboard."
msgstr "<0>Digitada</0>: uma assinatura digitada no teclado."

msgid "<0>Uploaded</0> - A signature that is uploaded from a file."
msgstr "<0>Carregada</0>: uma assinatura carregada de um arquivo."

